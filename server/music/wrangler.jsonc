{
  "name": "xp-music-api",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-23",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "durable_objects": { "bindings": [{ "name": "QISHUI_SESSIONS", "class_name": "QishuiSession" }] },
  "migrations": [{ "tag": "qishui-v1", "new_sqlite_classes": ["QishuiSession"] }],
  "routes": [{ "pattern": "music.xpeng.win", "custom_domain": true }],
  "define": { "process.env.NODE_ENV": "\"production\"", "process.env.JEST_WORKER_ID": "undefined", "process.env.LOG_LEVEL": "undefined" }
}
